{
  "name": "takt-public",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.prod.json && vite build",
    "test": "NODE_ENV=test vitest run",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx --max-warnings 0 && eslint tests --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src --fix && eslint tests --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md}\" --config ./.prettierrc.json && prettier --write \"tests/**/*.{js,jsx,ts,tsx,css,md}\" --config ./.prettierrc.json",
    "preview": "vite preview"
  },
  "pre-commit": [
    "lint"
  ],
  "dependencies": {
    "@tanstack/react-query": "5.76.1",
    "@types/react-transition-group": "4.4.12",
    "date-fns": "4.1.0",
    "logrocket": "10.0.0",
    "logrocket-react": "6.0.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-redux": "9.2.0",
    "@reduxjs/toolkit": "2.8.2",
    "react-router-dom": "7.6.0",
    "react-transition-group": "4.4.5",
    "react-yandex-metrika": "2.6.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/logrocket-react": "3.0.3",
    "@types/react-redux": "7.1.34",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@typescript-eslint/eslint-plugin": "8.32.1",
    "@typescript-eslint/parser": "8.32.1",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "8.57.1",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-prettier": "5.4.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.20",
    "jsdom": "26.1.0",
    "pre-commit": "1.2.2",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.1.3"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=20.0.0"
  }
}
